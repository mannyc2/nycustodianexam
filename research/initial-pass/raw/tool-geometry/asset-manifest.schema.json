{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nycustodianexam.example/schemas/tool-geometry-asset-manifest-v1.json",
  "title": "NYCustodianExam Tool Geometry Asset Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "assetId",
    "taxonomyId",
    "canonicalName",
    "sourcingClass",
    "geometryFamily",
    "state",
    "model",
    "parameters",
    "decisiveInvariants",
    "generatedOutputs",
    "validation",
    "reviews"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "assetId": {
      "type": "string",
      "pattern": "^ASSET-[A-Z0-9-]+$"
    },
    "taxonomyId": {
      "type": "string",
      "pattern": "^TOOL-[A-Z0-9-]+$"
    },
    "canonicalName": {
      "type": "string",
      "minLength": 1
    },
    "sourcingClass": {
      "enum": ["A", "B", "C", "D", "E", "F"]
    },
    "geometryFamily": {
      "enum": [
        "rigid_hand_tool",
        "articulated_hand_tool",
        "cleaning_implement",
        "powered_cleaning_equipment",
        "soft_deformable",
        "cart_material_handling",
        "ppe",
        "ladder_access",
        "other"
      ]
    },
    "state": {
      "enum": [
        "research",
        "briefed",
        "modeling",
        "validation_failed",
        "mechanical_review_pending",
        "rights_review_pending",
        "accessibility_review_pending",
        "release_candidate",
        "accepted",
        "retired",
        "blocked"
      ]
    },
    "model": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sourceType",
        "canonicalUnit",
        "coordinateConvention",
        "sourceFiles",
        "semanticVersion"
      ],
      "properties": {
        "sourceType": {
          "enum": [
            "project_parametric_brep",
            "accepted_external_cad",
            "accepted_scan",
            "deterministic_2d"
          ]
        },
        "canonicalUnit": {
          "const": "millimeter"
        },
        "coordinateConvention": {
          "type": "string",
          "minLength": 1
        },
        "semanticVersion": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
        },
        "sourceFiles": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/fileRecord"
          }
        },
        "buildEnvironmentDigest": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "parameters": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "value", "unit", "basis"],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "value": {
            "type": ["number", "string", "boolean"]
          },
          "unit": {
            "type": ["string", "null"]
          },
          "basis": {
            "enum": ["source", "measured", "derived", "editorial"]
          },
          "sourceIds": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "uncertainty": {
            "type": ["number", "null"],
            "minimum": 0
          },
          "note": {
            "type": "string"
          }
        }
      }
    },
    "decisiveInvariants": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "statement", "validationMode"],
        "properties": {
          "id": {
            "type": "string"
          },
          "statement": {
            "type": "string"
          },
          "validationMode": {
            "enum": [
              "automated",
              "human",
              "automated_and_human"
            ]
          },
          "testId": {
            "type": "string"
          }
        }
      }
    },
    "forbiddenTraits": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "components": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "role"],
        "properties": {
          "id": {
            "type": "string"
          },
          "role": {
            "type": "string"
          },
          "expectedContactWith": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "prohibitedIntersectionWith": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "requiredViews": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["viewId", "purpose", "controllingForScoredUse"],
        "properties": {
          "viewId": {
            "type": "string"
          },
          "purpose": {
            "type": "string"
          },
          "controllingForScoredUse": {
            "type": "boolean"
          },
          "cameraRecord": {
            "type": "object"
          }
        }
      }
    },
    "generatedOutputs": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/fileRecord"
      }
    },
    "validation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "brepValid",
        "componentCountValid",
        "unitsValid",
        "intersectionsValid",
        "meshChecksValid",
        "metadataLeakScanValid",
        "reproducibilityValid"
      ],
      "properties": {
        "brepValid": {
          "type": "boolean"
        },
        "componentCountValid": {
          "type": "boolean"
        },
        "unitsValid": {
          "type": "boolean"
        },
        "intersectionsValid": {
          "type": "boolean"
        },
        "meshChecksValid": {
          "type": "boolean"
        },
        "metadataLeakScanValid": {
          "type": "boolean"
        },
        "reproducibilityValid": {
          "type": "boolean"
        },
        "validationReport": {
          "$ref": "#/$defs/fileRecord"
        }
      }
    },
    "reviews": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mechanical",
        "rights",
        "accessibility",
        "security"
      ],
      "properties": {
        "mechanical": {
          "$ref": "#/$defs/reviewRecord"
        },
        "rights": {
          "$ref": "#/$defs/reviewRecord"
        },
        "accessibility": {
          "$ref": "#/$defs/reviewRecord"
        },
        "security": {
          "$ref": "#/$defs/reviewRecord"
        }
      }
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "fileRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "sizeBytes"],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "sizeBytes": {
          "type": "integer",
          "minimum": 0
        },
        "mediaType": {
          "type": "string"
        },
        "role": {
          "type": "string"
        }
      }
    },
    "reviewRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "basisDigests"],
      "properties": {
        "status": {
          "enum": [
            "not_started",
            "pending",
            "passed",
            "failed",
            "blocked"
          ]
        },
        "reviewerId": {
          "type": "string"
        },
        "reviewedAt": {
          "type": "string",
          "format": "date-time"
        },
        "policyVersion": {
          "type": "integer",
          "minimum": 1
        },
        "basisDigests": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/sha256"
          }
        },
        "notes": {
          "type": "string"
        }
      }
    }
  }
}
