{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "nycustodianexam",
  "main": "./src/asset-router.ts",
  "compatibility_date": "2026-08-23",
  "workers_dev": false,
  "preview_urls": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": [
      "/simulations/session/*",
      "/print/preview/*"
    ],
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  }
}
