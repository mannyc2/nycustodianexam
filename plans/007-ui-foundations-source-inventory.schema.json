{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nycustodianexam.example/schemas/ui007-provisional-source-inventory.schema.json",
  "title": "Plan 007 provisional UI-foundations source inventory",
  "description": "Fail-closed shape for dependency-neutral prework. This schema does not authorize Plan 007 execution or product-contract promotion.",
  "status": "provisional-prework",
  "participantEvidence": "none",
  "humanEvidence": "none",
  "humanParticipantCount": 0,
  "notHumanUsabilityTested": true,
  "reviewMode": "codex-only",
  "decisionStatus": "pending",
  "requiredDependencyShas": null,
  "mustRebaseAndReverify": true,
  "x-provisionalMetadata": {
    "status": "provisional-prework",
    "participantEvidence": "none",
    "humanEvidence": "none",
    "humanParticipantCount": 0,
    "notHumanUsabilityTested": true,
    "reviewMode": "codex-only",
    "decisionStatus": "pending",
    "requiredDependencyShas": null,
    "mustRebaseAndReverify": true
  },
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "status",
    "participantEvidence",
    "humanEvidence",
    "humanParticipantCount",
    "notHumanUsabilityTested",
    "reviewMode",
    "decisionStatus",
    "requiredDependencyShas",
    "mustRebaseAndReverify",
    "sourceBaseSha",
    "dependencyDecisionShas",
    "inventoryMethod",
    "sourceInventory",
    "foundations",
    "componentOwners",
    "routeFamilies",
    "screenStateDimensions",
    "screenStateFamilies",
    "archetypeTemplates",
    "harnessSpecification",
    "migrationTranches",
    "gapAssignments",
    "testCoverage",
    "supplementaryEvidence",
    "codexReviewLanes",
    "humanEvidenceRows",
    "decisionRecords"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "status": {
      "const": "provisional-prework"
    },
    "participantEvidence": {
      "const": "none"
    },
    "humanEvidence": {
      "const": "none"
    },
    "humanParticipantCount": {
      "const": 0
    },
    "notHumanUsabilityTested": {
      "const": true
    },
    "reviewMode": {
      "const": "codex-only"
    },
    "decisionStatus": {
      "const": "pending"
    },
    "requiredDependencyShas": {
      "const": null
    },
    "mustRebaseAndReverify": {
      "const": true
    },
    "sourceBaseSha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "dependencyDecisionShas": {
      "$ref": "#/$defs/dependencyDecisionShas"
    },
    "inventoryMethod": {
      "type": "string",
      "minLength": 1
    },
    "sourceInventory": {
      "$ref": "#/$defs/sourceInventory"
    },
    "foundations": {
      "type": "array",
      "minItems": 13,
      "maxItems": 13,
      "items": {
        "$ref": "#/$defs/foundation"
      }
    },
    "componentOwners": {
      "type": "array",
      "minItems": 12,
      "maxItems": 12,
      "items": {
        "$ref": "#/$defs/componentOwner"
      }
    },
    "routeFamilies": {
      "type": "array",
      "minItems": 21,
      "maxItems": 21,
      "items": {
        "$ref": "#/$defs/routeFamily"
      }
    },
    "screenStateDimensions": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "items": {
        "$ref": "#/$defs/stateDimension"
      }
    },
    "screenStateFamilies": {
      "type": "array",
      "minItems": 8,
      "items": {
        "$ref": "#/$defs/screenStateFamily"
      }
    },
    "archetypeTemplates": {
      "type": "array",
      "minItems": 7,
      "maxItems": 7,
      "items": {
        "$ref": "#/$defs/archetypeTemplate"
      }
    },
    "harnessSpecification": {
      "$ref": "#/$defs/harnessSpecification"
    },
    "migrationTranches": {
      "type": "array",
      "minItems": 8,
      "maxItems": 8,
      "items": {
        "$ref": "#/$defs/migrationTranche"
      }
    },
    "gapAssignments": {
      "type": "array",
      "minItems": 8,
      "maxItems": 8,
      "items": {
        "$ref": "#/$defs/gapAssignment"
      }
    },
    "testCoverage": {
      "$ref": "#/$defs/testCoverage"
    },
    "supplementaryEvidence": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/supplementaryEvidence"
      }
    },
    "codexReviewLanes": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "$ref": "#/$defs/codexReviewLane"
      }
    },
    "humanEvidenceRows": {
      "type": "array",
      "maxItems": 0
    },
    "decisionRecords": {
      "type": "array",
      "maxItems": 0
    }
  },
  "$defs": {
    "dependencyDecisionShas": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "step2DecisionSha", "step3DecisionSha", "shaFormat", "supplementaryEvidenceCanSubstitute"],
      "properties": {
        "status": {
          "const": "awaiting-exact-accepted-shas"
        },
        "step2DecisionSha": {
          "const": null
        },
        "step3DecisionSha": {
          "const": null
        },
        "shaFormat": {
          "const": "40-lowercase-hex"
        },
        "supplementaryEvidenceCanSubstitute": {
          "const": false
        }
      }
    },
    "identifier": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "nonemptyString": {
      "type": "string",
      "minLength": 1
    },
    "uniqueStrings": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "nonemptyUniqueStrings": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "sourceLocator": {
      "type": "string",
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[^:*?\\[\\]]+:[1-9][0-9]*$"
    },
    "repositoryFile": {
      "type": "string",
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[^:*?\\[\\]]+$"
    },
    "sourceInventory": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "stylesheet",
        "stylesheetLineCount",
        "definedTokens",
        "referencedTokens",
        "undefinedTokenReferences",
        "definedButUnusedTokens",
        "cssClassSelectors",
        "attributeSelectors",
        "renderedDataAttributes",
        "literalClassHooks",
        "unmatchedLiteralHooks",
        "unmatchedDynamicHooks",
        "dynamicClassExpressions",
        "createRootEntrypoints",
        "responsiveModes"
      ],
      "properties": {
        "stylesheet": {
          "$ref": "#/$defs/repositoryFile"
        },
        "stylesheetLineCount": {
          "type": "integer",
          "minimum": 1
        },
        "definedTokens": {
          "$ref": "#/$defs/nonemptyUniqueStrings"
        },
        "referencedTokens": {
          "$ref": "#/$defs/nonemptyUniqueStrings"
        },
        "undefinedTokenReferences": {
          "$ref": "#/$defs/nonemptyUniqueStrings"
        },
        "definedButUnusedTokens": {
          "$ref": "#/$defs/nonemptyUniqueStrings"
        },
        "cssClassSelectors": {
          "$ref": "#/$defs/nonemptyUniqueStrings"
        },
        "attributeSelectors": {
          "$ref": "#/$defs/nonemptyUniqueStrings"
        },
        "renderedDataAttributes": {
          "$ref": "#/$defs/nonemptyUniqueStrings"
        },
        "literalClassHooks": {
          "$ref": "#/$defs/nonemptyUniqueStrings"
        },
        "unmatchedLiteralHooks": {
          "$ref": "#/$defs/nonemptyUniqueStrings"
        },
        "unmatchedDynamicHooks": {
          "$ref": "#/$defs/nonemptyUniqueStrings"
        },
        "dynamicClassExpressions": {
          "type": "array",
          "minItems": 6,
          "maxItems": 6,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["source", "expressionFamily", "inspectionBoundary"],
            "properties": {
              "source": {
                "$ref": "#/$defs/sourceLocator"
              },
              "expressionFamily": {
                "$ref": "#/$defs/nonemptyString"
              },
              "inspectionBoundary": {
                "const": "finite values recorded; later source changes require reinventory"
              }
            }
          }
        },
        "createRootEntrypoints": {
          "type": "array",
          "minItems": 11,
          "maxItems": 11,
          "items": {
            "$ref": "#/$defs/repositoryFile"
          },
          "uniqueItems": true
        },
        "responsiveModes": {
          "type": "array",
          "minItems": 6,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "sources", "observedContract", "gap"],
            "properties": {
              "id": {
                "$ref": "#/$defs/identifier"
              },
              "sources": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "$ref": "#/$defs/sourceLocator"
                },
                "uniqueItems": true
              },
              "observedContract": {
                "$ref": "#/$defs/nonemptyString"
              },
              "gap": {
                "$ref": "#/$defs/nonemptyString"
              }
            }
          }
        }
      }
    },
    "foundation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "members", "currentOwners", "observedGaps", "decisionStatus", "apiStatus", "visualTokenStatus"],
      "properties": {
        "id": {
          "$ref": "#/$defs/identifier"
        },
        "members": {
          "$ref": "#/$defs/nonemptyUniqueStrings"
        },
        "currentOwners": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/sourceLocator"
          },
          "uniqueItems": true
        },
        "observedGaps": {
          "$ref": "#/$defs/nonemptyUniqueStrings"
        },
        "decisionStatus": {
          "const": "pending"
        },
        "apiStatus": {
          "const": "pending"
        },
        "visualTokenStatus": {
          "const": "pending"
        }
      }
    },
    "componentOwner": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "renderer", "mount", "owner", "stateOwner", "contentOwner", "currentContract"],
      "properties": {
        "id": {
          "$ref": "#/$defs/identifier"
        },
        "renderer": {
          "enum": ["static-generator", "react-island"]
        },
        "mount": {
          "oneOf": [
            { "$ref": "#/$defs/sourceLocator" },
            { "type": "null" }
          ]
        },
        "owner": {
          "$ref": "#/$defs/sourceLocator"
        },
        "stateOwner": {
          "$ref": "#/$defs/nonemptyString"
        },
        "contentOwner": {
          "$ref": "#/$defs/nonemptyString"
        },
        "currentContract": {
          "$ref": "#/$defs/nonemptyString"
        }
      }
    },
    "routeFamily": {
      "type": "object",
      "additionalProperties": false,
      "required": ["number", "routeIds", "implementedRouteIds", "implementationStatus", "currentOwners", "legalStateAnchor", "candidateTemplateIds", "decisionStatus"],
      "properties": {
        "number": {
          "type": "integer",
          "minimum": 1,
          "maximum": 21
        },
        "routeIds": {
          "$ref": "#/$defs/nonemptyUniqueStrings"
        },
        "implementedRouteIds": {
          "$ref": "#/$defs/uniqueStrings"
        },
        "implementationStatus": {
          "enum": ["implemented-currently", "documented-only-currently", "partially-implemented-currently"]
        },
        "currentOwners": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/sourceLocator"
          },
          "uniqueItems": true
        },
        "legalStateAnchor": {
          "$ref": "#/$defs/sourceLocator"
        },
        "candidateTemplateIds": {
          "$ref": "#/$defs/nonemptyUniqueStrings"
        },
        "decisionStatus": {
          "const": "pending"
        }
      }
    },
    "stateDimension": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "legalValues", "source"],
      "properties": {
        "id": {
          "$ref": "#/$defs/identifier"
        },
        "legalValues": {
          "$ref": "#/$defs/nonemptyUniqueStrings"
        },
        "source": {
          "$ref": "#/$defs/sourceLocator"
        }
      }
    },
    "screenStateFamily": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "sources", "maintainedContractStates", "currentImplementationStates", "recoveryInvariant", "presentationGap"],
      "properties": {
        "id": {
          "$ref": "#/$defs/identifier"
        },
        "sources": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/sourceLocator"
          },
          "uniqueItems": true
        },
        "maintainedContractStates": {
          "$ref": "#/$defs/nonemptyUniqueStrings"
        },
        "currentImplementationStates": {
          "$ref": "#/$defs/nonemptyUniqueStrings"
        },
        "recoveryInvariant": {
          "$ref": "#/$defs/nonemptyString"
        },
        "presentationGap": {
          "$ref": "#/$defs/nonemptyString"
        }
      }
    },
    "archetypeTemplate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "decisionStatus", "tokenInputs", "thresholds", "requiredSlots", "responsiveQuestions", "contentOwnership", "accessibilityResponsibilities", "testHooks"],
      "properties": {
        "id": {
          "$ref": "#/$defs/identifier"
        },
        "decisionStatus": {
          "const": "pending"
        },
        "tokenInputs": {
          "type": "null"
        },
        "thresholds": {
          "type": "null"
        },
        "requiredSlots": {
          "$ref": "#/$defs/nonemptyUniqueStrings"
        },
        "responsiveQuestions": {
          "$ref": "#/$defs/nonemptyUniqueStrings"
        },
        "contentOwnership": {
          "$ref": "#/$defs/nonemptyString"
        },
        "accessibilityResponsibilities": {
          "$ref": "#/$defs/nonemptyUniqueStrings"
        },
        "testHooks": {
          "$ref": "#/$defs/nonemptyUniqueStrings"
        }
      }
    },
    "stateFixture": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "routeId", "candidateTemplateId", "projection", "fixtureStatus", "publicPrecommitOnly", "answerBearing"],
      "properties": {
        "id": {
          "$ref": "#/$defs/identifier"
        },
        "routeId": {
          "$ref": "#/$defs/identifier"
        },
        "candidateTemplateId": {
          "$ref": "#/$defs/identifier"
        },
        "projection": {
          "$ref": "#/$defs/nonemptyString"
        },
        "fixtureStatus": {
          "const": "specification-only"
        },
        "publicPrecommitOnly": {
          "const": true
        },
        "answerBearing": {
          "const": false
        }
      }
    },
    "mode": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "evidence", "assertions"],
      "properties": {
        "id": {
          "$ref": "#/$defs/identifier"
        },
        "kind": {
          "const": "automated-specification"
        },
        "evidence": {
          "type": "null"
        },
        "assertions": {
          "$ref": "#/$defs/nonemptyUniqueStrings"
        }
      }
    },
    "harnessSpecification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["states", "modes", "totalPlannedRows", "automatedPlannedRows", "currentRows", "rowKey", "writerBoundary", "codexReviewBoundary"],
      "properties": {
        "states": {
          "type": "array",
          "minItems": 30,
          "maxItems": 30,
          "items": {
            "$ref": "#/$defs/stateFixture"
          }
        },
        "modes": {
          "type": "array",
          "minItems": 9,
          "maxItems": 9,
          "items": {
            "$ref": "#/$defs/mode"
          }
        },
        "totalPlannedRows": {
          "const": 270
        },
        "automatedPlannedRows": {
          "const": 270
        },
        "currentRows": {
          "const": 0
        },
        "rowKey": {
          "const": "stateId+modeId"
        },
        "writerBoundary": {
          "const": "must not emit rows until exact accepted Step 2 and Step 3 decision SHAs are present and the packet is rebased"
        },
        "codexReviewBoundary": {
          "const": "Codex engineering review is non-user evidence and is never human usability testing"
        }
      }
    },
    "migrationTranche": {
      "type": "object",
      "additionalProperties": false,
      "required": ["order", "id", "routeFamilyNumbers", "currentFiles", "prerequisiteFixtures", "foundationIds", "presentationCases", "answerLeakAndRouteClosureChecks", "removalCriteria", "stopBoundary"],
      "properties": {
        "order": {
          "type": "integer",
          "minimum": 1,
          "maximum": 8
        },
        "id": {
          "$ref": "#/$defs/identifier"
        },
        "routeFamilyNumbers": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "integer",
            "minimum": 1,
            "maximum": 21
          },
          "uniqueItems": true
        },
        "currentFiles": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/repositoryFile"
          },
          "uniqueItems": true
        },
        "prerequisiteFixtures": {
          "$ref": "#/$defs/nonemptyUniqueStrings"
        },
        "foundationIds": {
          "$ref": "#/$defs/nonemptyUniqueStrings"
        },
        "presentationCases": {
          "$ref": "#/$defs/nonemptyUniqueStrings"
        },
        "answerLeakAndRouteClosureChecks": {
          "$ref": "#/$defs/nonemptyUniqueStrings"
        },
        "removalCriteria": {
          "$ref": "#/$defs/nonemptyUniqueStrings"
        },
        "stopBoundary": {
          "$ref": "#/$defs/nonemptyString"
        }
      }
    },
    "gapAssignment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["trancheId", "undefinedTokens", "unmatchedHooks", "unmatchedDynamicHooks"],
      "properties": {
        "trancheId": {
          "$ref": "#/$defs/identifier"
        },
        "undefinedTokens": {
          "$ref": "#/$defs/uniqueStrings"
        },
        "unmatchedHooks": {
          "$ref": "#/$defs/uniqueStrings"
        },
        "unmatchedDynamicHooks": {
          "$ref": "#/$defs/uniqueStrings"
        }
      }
    },
    "testCoverage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["siteVitestFiles", "siteVitestDirectCallsites", "siteVitestEachCallsites", "siteVitestEffectCallsites", "siteVitestCallsites", "workspaceVitestFiles", "workspaceVitestDirectCallsites", "workspaceVitestEachCallsites", "workspaceVitestEffectCallsites", "workspaceVitestCallsites", "playwrightFiles", "playwrightDeclarations", "projects", "focusAssertions", "explicitTabSequences", "viewport320Cases", "largeTextAttributeAssertions", "axeCases", "forcedColorCases", "reducedMotionCases", "printMediaEmulations", "futureMatrixCoverage", "openCodexVerificationGaps"],
      "properties": {
        "siteVitestFiles": {
          "const": 30
        },
        "siteVitestDirectCallsites": {
          "const": 177
        },
        "siteVitestEachCallsites": {
          "const": 7
        },
        "siteVitestEffectCallsites": {
          "const": 40
        },
        "siteVitestCallsites": {
          "const": 224
        },
        "workspaceVitestFiles": {
          "const": 39
        },
        "workspaceVitestDirectCallsites": {
          "const": 224
        },
        "workspaceVitestEachCallsites": {
          "const": 14
        },
        "workspaceVitestEffectCallsites": {
          "const": 40
        },
        "workspaceVitestCallsites": {
          "const": 278
        },
        "playwrightFiles": {
          "const": 11
        },
        "playwrightDeclarations": {
          "const": 70
        },
        "projects": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": {
            "enum": ["chromium", "firefox", "webkit"]
          },
          "uniqueItems": true
        },
        "focusAssertions": {
          "type": "integer",
          "minimum": 0
        },
        "explicitTabSequences": {
          "type": "integer",
          "minimum": 0
        },
        "viewport320Cases": {
          "type": "integer",
          "minimum": 0
        },
        "largeTextAttributeAssertions": {
          "type": "integer",
          "minimum": 0
        },
        "axeCases": {
          "type": "integer",
          "minimum": 0
        },
        "forcedColorCases": {
          "type": "integer",
          "minimum": 0
        },
        "reducedMotionCases": {
          "type": "integer",
          "minimum": 0
        },
        "printMediaEmulations": {
          "type": "integer",
          "minimum": 0
        },
        "futureMatrixCoverage": {
          "const": "none"
        },
        "openCodexVerificationGaps": {
          "$ref": "#/$defs/nonemptyUniqueStrings"
        }
      }
    },
    "supplementaryEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "command", "result", "subject", "evidenceClass", "userParticipant", "countsTowardHumanEvidence", "countsTowardDecision", "canSubstituteForDependencyShas", "note"],
      "properties": {
        "id": {
          "$ref": "#/$defs/identifier"
        },
        "command": {
          "$ref": "#/$defs/nonemptyString"
        },
        "result": {
          "enum": ["pass", "fail", "pending"]
        },
        "subject": {
          "const": "current-site-not-plan007-prototype"
        },
        "evidenceClass": {
          "const": "non-user-supplementary-check"
        },
        "userParticipant": {
          "const": false
        },
        "countsTowardHumanEvidence": {
          "const": false
        },
        "countsTowardDecision": {
          "const": false
        },
        "canSubstituteForDependencyShas": {
          "const": false
        },
        "note": {
          "$ref": "#/$defs/nonemptyString"
        }
      }
    },
    "codexReviewLane": {
      "type": "object",
      "additionalProperties": false,
      "required": ["laneId", "protocol", "canonicalTaskId", "completionState", "scope", "reviewerType", "userParticipant", "humanEvidence", "notHumanUsabilityTested", "evidenceCoordinates", "findings", "consensus", "dissent", "dissentDisposition", "chainOfThoughtStored"],
      "properties": {
        "laneId": {
          "$ref": "#/$defs/identifier"
        },
        "protocol": {
          "const": "CODEX-ONLY-UIUX-V1"
        },
        "canonicalTaskId": {
          "type": "string",
          "pattern": "^/root/[a-z0-9_]+$"
        },
        "completionState": {
          "const": "completed"
        },
        "scope": {
          "enum": ["component-api-coherence", "responsive-accessibility-behavior", "implementation-migration-risk"]
        },
        "reviewerType": {
          "const": "codex-subagent"
        },
        "userParticipant": {
          "const": false
        },
        "humanEvidence": {
          "const": "none"
        },
        "notHumanUsabilityTested": {
          "const": true
        },
        "evidenceCoordinates": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/sourceLocator"
          }
        },
        "findings": {
          "$ref": "#/$defs/nonemptyUniqueStrings"
        },
        "consensus": {
          "enum": ["no-blocking-dissent", "blocking-dissent"]
