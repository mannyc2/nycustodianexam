{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/mannyc2/nycustodianexam/blob/main/plans/006-consumer-visual-system-prework.schema.json",
  "title": "Plan 006 consumer visual-system provisional prework",
  "description": "Draft 2020-12 schema constrained to the complete in-repository portable subset declared by x-validationProfile; covers deterministic prework that is not Plan 006 research, user research, a completed Codex review, selection, or acceptance.",
  "x-artifactLabel": {
    "status": "provisional-prework",
    "participantEvidence": "none",
    "decisionStatus": "pending",
    "requiredDependencyShas": null,
    "mustRebaseAndReverify": true
  },
  "x-validationProfile": "draft-2020-12-portable-subset-v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "artifactId",
    "schemaPath",
    "label",
    "sourceSnapshot",
    "captureManifest",
    "codexOnlyWorkflow",
    "assetInventory",
    "benchmarkTemplate",
    "prototypeEngine",
    "evidenceInterfaces",
    "gateAccounting"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "artifactId": { "const": "plan-006-consumer-visual-system-provisional-prework" },
    "schemaPath": { "const": "plans/006-consumer-visual-system-prework.schema.json" },
    "label": { "$ref": "#/$defs/artifactLabel" },
    "sourceSnapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "label",
        "observedAt",
        "sourceMainSha",
        "branch",
        "planStatuses",
        "contentDesignExists",
        "canonicalPlan006ResearchExists",
        "sourceFiles"
      ],
      "properties": {
        "label": { "$ref": "#/$defs/artifactLabel" },
        "observedAt": { "type": "string", "format": "date-time" },
        "sourceMainSha": { "$ref": "#/$defs/gitSha" },
        "branch": { "const": "codex/uiux-orchestration-03-visual-territories" },
        "planStatuses": {
          "type": "object",
          "additionalProperties": false,
          "required": ["004", "005", "006"],
          "properties": {
            "004": { "const": "BLOCKED" },
            "005": { "const": "BLOCKED" },
            "006": { "const": "BLOCKED" }
          }
        },
        "contentDesignExists": { "const": false },
        "canonicalPlan006ResearchExists": { "const": false },
        "sourceFiles": {
          "type": "array",
          "minItems": 14,
          "maxItems": 14,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/sourceFile" }
        }
      }
    },
    "captureManifest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "label",
        "canonicalBaselineStatus",
        "cases",
        "presentations",
        "toolingContract",
        "transientDryRun"
      ],
      "properties": {
        "label": { "$ref": "#/$defs/artifactLabel" },
        "canonicalBaselineStatus": { "const": "not-created" },
        "cases": {
          "type": "array",
          "minItems": 24,
          "maxItems": 24,
          "items": { "$ref": "#/$defs/captureCase" }
        },
        "presentations": {
          "type": "array",
          "minItems": 9,
          "maxItems": 9,
          "items": { "$ref": "#/$defs/presentation" }
        },
        "toolingContract": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "buildCommands",
            "browser",
            "browserPackagePath",
            "axePackagePath",
            "captureRootPattern",
            "loopbackOnly",
            "committedScreenshotCount",
            "futureCanonicalFields",
            "freshnessChecks",
            "retention"
          ],
          "properties": {
            "buildCommands": { "type": "array", "minItems": 2, "items": { "type": "string", "minLength": 1 } },
            "browser": { "const": "chromium" },
            "browserPackagePath": { "const": "apps/site/node_modules/@playwright/test/index.mjs" },
            "axePackagePath": { "const": "apps/site/node_modules/@axe-core/playwright/dist/index.mjs" },
            "captureRootPattern": { "type": "string", "pattern": "^/tmp/" },
            "loopbackOnly": { "const": true },
            "committedScreenshotCount": { "const": 0 },
            "futureCanonicalFields": { "type": "array", "minItems": 3, "uniqueItems": true, "items": { "type": "string" } },
            "freshnessChecks": { "type": "array", "minItems": 8, "uniqueItems": true, "items": { "type": "string" } },
            "retention": { "const": "temporary-under-/tmp-only" }
          }
        },
        "transientDryRun": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "label",
            "evidenceClass",
            "verificationStatus",
            "aggregates",
            "harnessContract",
            "metrics",
            "presentationAdapterLimitations",
            "receipt",
            "screenshotsRetained"
          ],
          "properties": {
            "label": { "$ref": "#/$defs/artifactLabel" },
            "evidenceClass": { "const": "supplementary-committed-non-image-current-control-metrics" },
            "verificationStatus": { "const": "self-consistent-receipt-not-canonical-baseline" },
            "aggregates": {
              "type": "object",
              "additionalProperties": false,
              "required": ["caseCount", "defaultPhoneDistinctScreenshotHashCount", "externalOriginCount", "httpSuccessCount", "overflowCaseIds"],
              "properties": {
                "caseCount": { "const": 24 },
                "defaultPhoneDistinctScreenshotHashCount": { "const": 16 },
                "externalOriginCount": { "const": 0 },
                "httpSuccessCount": { "const": 24 },
                "overflowCaseIds": { "const": ["C12", "C13", "C20", "C21"] }
              }
            },
            "harnessContract": {
              "const": {
                "adapters": {
                  "builtInLargeText": "transient-root-font-125-percent-emulation",
                  "textZoom": "transient-root-font-presentation-percent-emulation"
                },
                "browser": "chromium",
                "caseOrder": "captureManifest.cases-array-order",
                "externalOriginRule": "unique request origins not equal to http://127.0.0.1:4173 per case",
                "httpResult": "main-navigation-response-status",
                "locale": "en-US",
                "media": "captureManifest.presentations.media",
                "measurementRule": "document-and-body-clientWidth-and-scrollWidth-after-networkidle-plus-100ms-settle",
                "network": "loopback-only-preview-at-127.0.0.1",
                "routeIdentity": "body-data-route-id-must-equal-capture-case-routeId",
                "screenshotRetention": "hash-in-memory-then-discard-bytes",
                "screenshotSettings": "full-page-animations-disabled-sha256",
                "timing": "capturedAt-after-widths-and-screenshot-within-receipt-interval",
                "timezone": "UTC",
                "viewport": "captureManifest.presentations-width-height"
              }
            },
            "metrics": { "type": "array", "minItems": 24, "maxItems": 24, "items": { "$ref": "#/$defs/currentControlMetric" } },
            "presentationAdapterLimitations": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string" } },
            "receipt": { "$ref": "#/$defs/currentControlReceipt" },
            "screenshotsRetained": { "const": false }
          }
        }
      }
    },
    "codexOnlyWorkflow": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "label",
        "protocolId",
        "humanEvidence",
        "humanParticipantCount",
        "humanReviewRequired",
        "notHumanUsabilityTested",
        "requiredDependency",
        "independence",
        "rubrics",
        "reviewRecordContract",
        "reviewRecords",
        "decisionRule",
        "consensus"
      ],
      "properties": {
        "label": { "$ref": "#/$defs/artifactLabel" },
        "protocolId": { "const": "CODEX-ONLY-UIUX-V1" },
        "humanEvidence": { "const": "none" },
        "humanParticipantCount": { "const": 0 },
        "humanReviewRequired": { "const": false },
        "notHumanUsabilityTested": { "const": true },
        "requiredDependency": {
          "type": "object",
          "additionalProperties": false,
          "required": ["futureVerificationChecks", "kind", "sha", "status"],
          "properties": {
            "futureVerificationChecks": { "const": ["full-forty-character-sha", "commit-exists", "merged-into-main-or-ancestor-proof", "language-and-navigation-consumers-resolve-from-same-sha"] },
            "kind": { "const": "exact-merged-step-2-agent-only-language-navigation-sha" },
            "sha": { "type": "null" },
            "status": { "const": "awaiting-coordinator-supplied-exact-sha" }
          }
        },
        "independence": {
          "type": "object",
          "additionalProperties": false,
          "required": ["agentReviewsAreNotUserResearch", "agentsAreNonhumanEvidence", "distinctAgentTaskIdsRequired", "onePrimaryRubricPerAgentTaskId"],
          "properties": {
            "agentReviewsAreNotUserResearch": { "const": true },
            "agentsAreNonhumanEvidence": { "const": true },
            "distinctAgentTaskIdsRequired": { "const": true },
            "onePrimaryRubricPerAgentTaskId": { "const": true }
          }
        },
        "rubrics": { "type": "array", "minItems": 3, "maxItems": 3, "items": { "$ref": "#/$defs/codexReviewRubric" } },
        "reviewRecordContract": {
          "type": "object",
          "additionalProperties": false,
          "required": ["criterionClosureRule", "dissentFields", "evidenceCoordinateFields", "evidenceCoordinateFormat", "fixedFields", "requiredFields", "scoreMaximum", "scoreMinimum", "territoryIds", "territoryScoreFields"],
          "properties": {
            "criterionClosureRule": { "const": "each-rubric-criterion-scored-exactly-once-per-territory" },
            "dissentFields": { "const": ["agentTaskId", "territoryId", "reason", "evidenceCoordinates"] },
            "evidenceCoordinateFields": { "const": ["path", "anchor", "claim"] },
            "evidenceCoordinateFormat": { "const": "repository-relative-path#stable-anchor-or-Lline" },
            "fixedFields": { "const": { "crossReviewOutputsReadBeforeSubmission": false, "evidenceClass": "nonhuman-codex-review-not-user-research", "independentReview": true, "notHumanUsabilityTested": true } },
            "requiredFields": { "const": ["agentTaskId", "rubricId", "sourceSha", "prototypeSha256", "evidenceClass", "notHumanUsabilityTested", "independentReview", "crossReviewOutputsReadBeforeSubmission", "reviewedAt", "territoryScores", "evidenceCoordinates", "consensusPosition", "dissent"] },
            "scoreMaximum": { "const": 5 },
            "scoreMinimum": { "const": 1 },
            "territoryIds": { "const": ["A", "B", "C"] },
            "territoryScoreFields": { "const": ["territoryId", "criterionScores", "total", "blockingFindings"] }
          }
        },
        "reviewRecords": { "type": "array", "maxItems": 0 },
        "decisionRule": {
          "type": "object",
          "additionalProperties": false,
          "required": ["aggregation", "blockingFindingRule", "dissentRule", "minimumIndependentReviewCount", "requiredDistinctRubricCount", "selectionRule", "tieRule", "unresolvedDissentPreventsSelection"],
          "properties": {
            "aggregation": { "const": "sum-unweighted-criterion-scores-by-territory" },
            "blockingFindingRule": { "const": "any-blocking-finding-prevents-selection" },
            "dissentRule": { "const": "preserve-all-non-consensus-positions-and-evidence-coordinates" },
            "minimumIndependentReviewCount": { "const": 3 },
            "requiredDistinctRubricCount": { "const": 3 },
            "selectionRule": { "const": "unique-highest-nonblocked-total" },
            "tieRule": { "const": "pending-no-selection" },
            "unresolvedDissentPreventsSelection": { "const": true }
          }
        },
        "consensus": {
          "type": "object",
          "additionalProperties": false,
          "required": ["dissent", "status", "supportingAgentTaskIds", "territoryId"],
          "properties": {
            "dissent": { "type": "array", "maxItems": 0 },
            "status": { "const": "not-run-awaiting-exact-step-2-sha" },
            "supportingAgentTaskIds": { "type": "array", "maxItems": 0 },
            "territoryId": { "type": "null" }
          }
        }
      }
    },
    "assetInventory": {
      "type": "object",
      "additionalProperties": false,
      "required": ["label", "attachmentBaseline", "counts", "sourceLedgers", "entries", "futureVisualAuditFields"],
      "properties": {
        "attachmentBaseline": {
          "type": "object",
          "additionalProperties": false,
          "required": ["label", "archive", "authority", "defaultVerificationStatus", "entryCounts", "entries", "inspection", "optionalExternalArchiveRecheck"],
          "properties": {
            "label": { "$ref": "#/$defs/artifactLabel" },
            "archive": {
              "type": "object",
              "additionalProperties": false,
              "required": ["logicalSourceId", "bytes", "sha256"],
              "properties": {
                "logicalSourceId": { "const": "user-supplied/nyc-custodian-component-design/old-system-pass-one" },
                "bytes": { "const": 1428961 },
                "sha256": { "const": "dcbf9fcf9a8c43e263bfbc501dfb1ec2d98f21eda5126ffa9181c50cac795442" }
              }
            },
            "authority": { "const": "uninformed-old-system-pass-one-baseline-not-selected-not-a-constraint" },
            "defaultVerificationStatus": { "const": "ledger-only-not-deep-reverified" },
            "entryCounts": {
              "type": "object",
              "additionalProperties": false,
              "required": ["archiveEntries", "canonicalDerivativeCopies", "evidenceOnlyFiles", "totalUncompressedBytes"],
              "properties": {
                "archiveEntries": { "const": 15 },
                "canonicalDerivativeCopies": { "const": 11 },
                "evidenceOnlyFiles": { "const": 4 },
                "totalUncompressedBytes": { "const": 1596384 }
              }
            },
            "entries": {
              "type": "array",
              "minItems": 15,
              "maxItems": 15,
              "items": { "$ref": "#/$defs/attachmentEntry" }
            },
            "inspection": {
              "type": "object",
              "additionalProperties": false,
              "required": ["archiveCommentPresent", "dynamicExternalCodeCapability", "entryPathSafety", "externalNetworkDependencyStatus", "genericRemoteModuleFetchCapability", "htmlLiteralExternalSubresourceCount", "ledgerRowsMatchingCanonicalRepoHashes", "runtimeCdnFallbackCount", "runtimeCdnFallbackUrls", "scannedTextMarkerObservation", "transientExtractionRetained"],
              "properties": {
                "archiveCommentPresent": { "const": false },
                "dynamicExternalCodeCapability": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["directEvalCallCount", "dynamicImportCount", "functionConstructorCount", "mechanism", "status"],
                  "properties": {
                    "directEvalCallCount": { "const": 0 },
                    "dynamicImportCount": { "const": 0 },
                    "functionConstructorCount": { "const": 2 },
                    "mechanism": { "const": "new Function" },
                    "status": { "const": "present-do-not-execute" }
                  }
                },
                "entryPathSafety": { "const": "pass-no-absolute-or-parent-paths" },
                "externalNetworkDependencyStatus": { "const": "old-support-js-has-three-unpkg-fallbacks-dynamic-remote-fetch-and-new-Function-prohibited-for-future-prototypes" },
                "genericRemoteModuleFetchCapability": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["dynamicArgumentFetchCallCount", "mechanism", "status"],
                  "properties": {
                    "dynamicArgumentFetchCallCount": { "const": 3 },
                    "mechanism": { "const": "fetch(dynamic-url)" },
                    "status": { "const": "present-do-not-execute" }
                  }
                },
                "htmlLiteralExternalSubresourceCount": { "const": 0 },
                "ledgerRowsMatchingCanonicalRepoHashes": { "const": 11 },
                "runtimeCdnFallbackCount": { "const": 3 },
                "runtimeCdnFallbackUrls": {
                  "const": [
                    "https://unpkg.com/react@18.3.1/umd/react.production.min.js",
                    "https://unpkg.com/react-dom@18.3.1/umd/react-dom.production.min.js",
                    "https://unpkg.com/@babel/standalone@7.29.0/babel.min.js"
                  ]
                },
                "scannedTextMarkerObservation": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["caseInsensitiveWholeWordMarkers", "matchingEntryCount", "rightsInference", "scannedEntries", "status"],
                  "properties": {
                    "caseInsensitiveWholeWordMarkers": { "const": ["license", "copyright", "SPDX"] },
                    "matchingEntryCount": { "const": 0 },
                    "rightsInference": { "const": "none-rights-remain-unknown" },
                    "scannedEntries": { "const": ["Component Library.dc.html", "github.md", "support.js"] },
                    "status": { "const": "no-marker-match-observed-not-no-license" }
                  }
                },
                "transientExtractionRetained": { "const": false }
              }
            },
            "optionalExternalArchiveRecheck": {
              "type": "object",
              "additionalProperties": false,
              "required": ["argument", "inferred", "pathStored", "required", "retainsBytes"],
              "properties": {
                "argument": { "const": "--attachment" },
                "inferred": { "const": false },
                "pathStored": { "const": false },
                "required": { "const": false },
                "retainsBytes": { "const": false }
              }
            }
          }
        },
        "label": { "$ref": "#/$defs/artifactLabel" },
        "counts": {
          "type": "object",
          "additionalProperties": false,
          "required": ["tool", "comparison", "scene", "total"],
          "properties": {
            "tool": { "const": 65 },
            "comparison": { "const": 14 },
            "scene": { "const": 18 },
            "total": { "const": 97 }
          }
        },
        "sourceLedgers": { "type": "array", "minItems": 4, "uniqueItems": true, "items": { "$ref": "#/$defs/sourceFile" } },
        "entries": {
          "type": "array",
          "minItems": 97,
          "maxItems": 97,
          "items": { "$ref": "#/$defs/assetEntry" }
        },
        "futureVisualAuditFields": { "type": "array", "minItems": 18, "maxItems": 18, "uniqueItems": true, "items": { "type": "string" } }
      }
    },
    "benchmarkTemplate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "label",
        "acquisitionStatus",
        "observedAcquiredCount",
        "targetValidatedRows",
        "categories",
        "acquisitionSlots",
        "canonicalSourceFields",
        "qualitativeEvaluationFields",
        "sources",
        "claimPolicy"
      ],
      "properties": {
        "label": { "$ref": "#/$defs/artifactLabel" },
        "acquisitionStatus": { "const": "not-started" },
        "observedAcquiredCount": { "const": 0 },
        "targetValidatedRows": {
          "type": "object",
          "additionalProperties": false,
          "required": ["minimum", "maximum", "minimumPerCategory"],
          "properties": {
            "minimum": { "const": 10 },
            "maximum": { "const": 12 },
            "minimumPerCategory": { "const": 2 }
          }
        },
        "categories": {
          "const": [
            "exam-preparation",
            "public-service-reference",
            "practical-visual-learning",
            "no-account-offline-education"
          ]
        },
        "acquisitionSlots": {
          "type": "array",
          "minItems": 12,
          "maxItems": 12,
          "items": { "$ref": "#/$defs/benchmarkSlot" }
        },
        "canonicalSourceFields": { "type": "array", "minItems": 10, "maxItems": 10, "uniqueItems": true, "items": { "type": "string" } },
        "qualitativeEvaluationFields": { "type": "array", "minItems": 20, "uniqueItems": true, "items": { "type": "string" } },
        "sources": { "type": "array", "maxItems": 0 },
        "claimPolicy": { "type": "array", "minItems": 4, "uniqueItems": true, "items": { "type": "string" } }
      }
    },
    "prototypeEngine": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "label",
        "dependencyContract",
        "engineStatus",
        "futureInputs",
        "sharedInvariantFields",
        "operations",
        "permittedTerritoryOverrides",
        "routeArchetypes",
        "selectionInputContract",
        "territories",
        "tokenRoles",
        "renderContract",
        "prohibitions"
      ],
      "properties": {
        "label": { "$ref": "#/$defs/artifactLabel" },
        "dependencyContract": {
          "type": "object",
          "additionalProperties": false,
          "required": ["requiredMergedStep2Sha", "sourceKind", "status"],
          "properties": {
            "requiredMergedStep2Sha": { "type": "null" },
            "sourceKind": { "const": "exact-merged-step-2-agent-only-language-navigation-sha" },
            "status": { "const": "awaiting-coordinator-supplied-exact-sha" }
          }
        },
        "engineStatus": { "const": "blocked-awaiting-exact-merged-step-2-sha" },
        "futureInputs": {
          "type": "object",
          "additionalProperties": false,
          "required": ["language", "navigation"],
          "properties": {
            "language": { "$ref": "#/$defs/futureInput" },
            "navigation": { "$ref": "#/$defs/futureInput" }
          }
        },
        "sharedInvariantFields": { "type": "array", "minItems": 8, "uniqueItems": true, "items": { "type": "string" } },
        "operations": {
          "const": [
            "verifyMergedStep2Dependency",
            "bindLanguageContract",
            "bindNavigationContract",
            "normalizeSharedContent",
            "renderArchetype",
            "semanticFingerprint",
            "styleFingerprint"
          ]
        },
        "permittedTerritoryOverrides": {
          "const": ["tokens", "densityRules", "imageFraming", "cssComposition"]
        },
        "routeArchetypes": { "type": "array", "minItems": 7, "maxItems": 7, "items": { "$ref": "#/$defs/routeArchetype" } },
        "selectionInputContract": {
          "type": "object",
          "additionalProperties": false,
          "required": ["minimumIndependentCodexReviews", "protocolId", "prototypeStatus", "requiredMergedStep2Sha", "requiredPrototypeSha256", "status"],
          "properties": {
            "minimumIndependentCodexReviews": { "const": 3 },
            "protocolId": { "const": "CODEX-ONLY-UIUX-V1" },
            "prototypeStatus": { "const": "not-built" },
            "requiredMergedStep2Sha": { "type": "null" },
            "requiredPrototypeSha256": { "type": "null" },
            "status": { "const": "blocked-awaiting-exact-step-2-sha" }
          }
        },
        "territories": { "type": "array", "minItems": 3, "maxItems": 3, "items": { "$ref": "#/$defs/territory" } },
        "tokenRoles": { "type": "array", "minItems": 70, "uniqueItems": true, "items": { "type": "string" } },
        "renderContract": {
          "type": "object",
          "additionalProperties": false,
          "required": ["rendererCount", "territoryCount", "archetypeCount", "minimumFrameCount", "serverBinding", "assetAllowlist", "crossTerritoryEquality"],
          "properties": {
            "rendererCount": { "const": 1 },
            "territoryCount": { "const": 3 },
            "archetypeCount": { "const": 7 },
            "minimumFrameCount": { "const": 21 },
            "serverBinding": { "const": "127.0.0.1" },
            "assetAllowlist": { "type": "array", "minItems": 3, "maxItems": 3, "uniqueItems": true, "items": { "type": "string" } },
            "crossTerritoryEquality": { "type": "array", "minItems": 8, "uniqueItems": true, "items": { "type": "string" } }
          }
        },
        "prohibitions": { "type": "array", "minItems": 22, "uniqueItems": true, "items": { "type": "string" } }
      }
    },
    "evidenceInterfaces": {
      "type": "object",
      "additionalProperties": false,
      "required": ["label", "interfaces", "routeSimulationTasks"],
      "properties": {
        "label": { "$ref": "#/$defs/artifactLabel" },
        "interfaces": { "type": "array", "minItems": 5, "maxItems": 5, "items": { "$ref": "#/$defs/evidenceInterface" } },
        "routeSimulationTasks": { "type": "array", "minItems": 7, "maxItems": 7, "items": { "$ref": "#/$defs/routeSimulationTask" } }
      }
    },
    "gateAccounting": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "label",
        "humanEvidence",
        "humanParticipantCount",
        "humanReviewRequired",
        "notHumanUsabilityTested",
        "codexReviewCount",
        "codexReviewTaskIds",
        "codexConsensusStatus",
        "advancingTerritoryIds",
        "finalistTerritoryIds",
        "selectedTerritoryId",
        "winnerTerritoryId",
        "recommendedTerritoryId",
        "hybrid",
        "canonicalPromotionPerformed",
        "plan006DoneClaimed"
      ],
      "properties": {
        "label": { "$ref": "#/$defs/artifactLabel" },
        "humanEvidence": { "const": "none" },
        "humanParticipantCount": { "const": 0 },
        "humanReviewRequired": { "const": false },
        "notHumanUsabilityTested": { "const": true },
        "codexReviewCount": { "const": 0 },
        "codexReviewTaskIds": { "type": "array", "maxItems": 0 },
        "codexConsensusStatus": { "const": "not-run-awaiting-exact-step-2-sha" },
        "advancingTerritoryIds": { "type": "array", "maxItems": 0 },
        "finalistTerritoryIds": { "type": "array", "maxItems": 0 },
        "selectedTerritoryId": { "type": "null" },
        "winnerTerritoryId": { "type": "null" },
        "recommendedTerritoryId": { "type": "null" },
        "hybrid": { "const": false },
        "canonicalPromotionPerformed": { "const": false },
        "plan006DoneClaimed": { "const": false }
      }
    }
  },
  "$defs": {
    "artifactLabel": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "participantEvidence", "decisionStatus", "requiredDependencyShas", "mustRebaseAndReverify"],
      "properties": {
        "status": { "const": "provisional-prework" },
        "participantEvidence": { "const": "none" },
        "decisionStatus": { "const": "pending" },
        "requiredDependencyShas": { "type": "null" },
        "mustRebaseAndReverify": { "const": true }
      }
    },
    "gitSha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "sourceFile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": { "type": "string", "pattern": "^[^/].+" },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "attachmentEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["bytes", "canonicalRepoPath", "contentKind", "path", "rightsStatus", "sha256", "useStatus"],
      "properties": {
        "bytes": { "type": "integer", "minimum": 1 },
        "canonicalRepoPath": { "oneOf": [{ "type": "null" }, { "type": "string", "pattern": "^content/assets/derivatives/" }] },
        "contentKind": { "enum": ["generated-preview-thumbnail", "old-component-library-html", "canonical-derivative-copy", "old-baseline-metadata", "old-renderer-runtime"] },
        "path": { "type": "string", "minLength": 1 },
        "rightsStatus": { "const": "unknown-attachment-rights-not-determined" },
        "sha256": { "$ref": "#/$defs/sha256" },
        "useStatus": { "enum": ["evidence-only-do-not-copy-to-product-or-prototype", "use-only-via-byte-identical-canonical-repo-derivative"] }
      }
    },
    "presentation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["presentationId", "width", "height", "builtInLargeText", "textZoomPercent", "forcedColors", "reducedMotion", "media"],
      "properties": {
        "presentationId": { "type": "string", "pattern": "^[a-z0-9-]+$" },
        "width": { "type": "integer", "minimum": 320 },
        "height": { "type": "integer", "minimum": 720 },
        "builtInLargeText": { "type": "boolean" },
        "textZoomPercent": { "type": "integer", "minimum": 100, "maximum": 200 },
        "forcedColors": { "type": "boolean" },
        "reducedMotion": { "type": "boolean" },
        "media": { "enum": ["screen", "print"] }
      }
    },
    "captureCase": {
      "type": "object",
      "additionalProperties": false,
      "required": ["caseId", "routeId", "routePath", "presentationId", "captureStatus", "captureId", "sha256", "capturedAt"],
      "properties": {
        "caseId": { "type": "string", "pattern": "^C(0[1-9]|1[0-9]|2[0-4])$" },
        "routeId": { "type": "string", "pattern": "^[a-z0-9-]+$" },
        "routePath": { "type": "string", "pattern": "^/" },
        "presentationId": { "type": "string", "pattern": "^[a-z0-9-]+$" },
        "captureStatus": { "const": "pending-future-canonical-run" },
        "captureId": { "type": "null" },
        "sha256": { "type": "null" },
        "capturedAt": { "type": "null" }
      }
    },
    "currentControlMetric": {
      "type": "object",
      "additionalProperties": false,
      "required": ["bodyClientWidth", "bodyScrollWidth", "capturedAt", "caseId", "documentClientWidth", "documentScrollWidth", "externalOriginCount", "httpStatus", "presentationId", "repositoryRelativeUrl", "routeId", "screenshotSha256"],
      "properties": {
        "bodyClientWidth": { "type": "integer", "minimum": 1 },
        "bodyScrollWidth": { "type": "integer", "minimum": 1 },
        "capturedAt": { "type": "string", "format": "date-time" },
        "caseId": { "type": "string", "pattern": "^C(0[1-9]|1[0-9]|2[0-4])$" },
        "documentClientWidth": { "type": "integer", "minimum": 1 },
        "documentScrollWidth": { "type": "integer", "minimum": 1 },
        "externalOriginCount": { "type": "integer", "minimum": 0 },
        "httpStatus": { "const": 200 },
        "presentationId": { "type": "string", "pattern": "^[a-z0-9-]+$" },
        "repositoryRelativeUrl": { "type": "string", "pattern": "^/" },
        "routeId": { "type": "string", "pattern": "^[a-z0-9-]+$" },
        "screenshotSha256": { "oneOf": [{ "$ref": "#/$defs/sha256" }, { "type": "null" }] }
      }
    },
    "currentControlReceipt": {
      "type": "object",
      "additionalProperties": false,
      "required": ["browserName", "browserVersion", "canonicalization", "caseCount", "completedAt", "harnessContractSha256", "harnessId", "metricsSha256", "receiptSha256", "sourceSha", "startedAt"],
      "properties": {
        "browserName": { "const": "chromium" },
        "browserVersion": { "type": "string", "minLength": 1 },
        "canonicalization": { "const": "UTF-8 JSON.stringify after recursive lexicographic object-key sorting; array order preserved; no trailing LF" },
        "caseCount": { "const": 24 },
        "completedAt": { "type": "string", "format": "date-time" },
        "harnessContractSha256": { "$ref": "#/$defs/sha256" },
        "harnessId": { "const": "plan006-current-control-metrics-v1" },
        "metricsSha256": { "$ref": "#/$defs/sha256" },
        "receiptSha256": { "$ref": "#/$defs/sha256" },
        "sourceSha": { "$ref": "#/$defs/gitSha" },
        "startedAt": { "type": "string", "format": "date-time" }
      }
    },
    "derivative": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "bytes", "sha256", "width", "height"],
      "properties": {
        "path": { "type": "string", "pattern": "^content/assets/derivatives/" },
        "bytes": { "type": "integer", "minimum": 1 },
        "sha256": { "$ref": "#/$defs/sha256" },
        "width": { "type": "integer", "minimum": 1 },
        "height": { "type": "integer", "minimum": 1 }
      }
    },
    "masterAsset": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "bytes", "sha256"],
      "properties": {
        "path": { "type": "string", "pattern": "^content/assets/masters/" },
        "bytes": { "type": "integer", "minimum": 1 },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "assetEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "assetType",
        "stableId",
        "opaqueAssetId",
        "revision",
        "sourceReleaseStatus",
        "sourceLedger",
        "master",
        "web",
        "phone",
        "print",
        "rightsReview",
        "use",
        "visualAuditStatus"
      ],
      "properties": {
        "assetType": { "enum": ["tool", "comparison", "scene"] },
        "stableId": { "type": "string", "minLength": 3 },
        "opaqueAssetId": { "type": "string", "pattern": "^[tps][0-9]{3}$" },
        "revision": { "oneOf": [{ "type": "integer", "minimum": 1 }, { "const": "n/a" }] },
        "sourceReleaseStatus": { "const": "accepted" },
        "sourceLedger": { "type": "string", "pattern": "^content/authoring/visuals/releases/" },
        "master": { "$ref": "#/$defs/masterAsset" },
        "web": { "$ref": "#/$defs/derivative" },
        "phone": { "$ref": "#/$defs/derivative" },
        "print": { "$ref": "#/$defs/derivative" },
        "rightsReview": {
          "type": "object",
          "additionalProperties": false,
          "required": ["outcome", "statement", "source"],
          "properties": {
            "outcome": { "enum": ["pass", "accepted-master-input-composition"] },
            "statement": { "type": "string", "minLength": 12 },
            "source": { "type": "string", "minLength": 5 }
          }
        },
        "use": {
          "type": "object",
          "additionalProperties": false,
          "required": ["codexOnlyDisposition", "practiceEligibility", "prototypeBoundary", "scopeStatus", "upstreamSourceGateText"],
          "properties": {
            "codexOnlyDisposition": { "enum": ["accepted-derivative-eligible-within-recorded-practice-scope", "prohibited-from-scored-and-prototype-use"] },
            "practiceEligibility": { "enum": ["entry-level-supported", "atlas-only-watchlist-or-gated", "hazard-assessment-only"] },
            "prototypeBoundary": { "type": "string", "minLength": 12 },
            "scopeStatus": { "const": "source-fact-only-no-route-identity-decision" },
            "upstreamSourceGateText": { "oneOf": [{ "type": "null" }, { "type": "string", "minLength": 1 }] }
          }
        },
        "visualAuditStatus": { "const": "pending-future-plan-006-per-pixel-audit" }
      }
    },
    "futureInput": {
      "type": "object",
      "additionalProperties": false,
      "required": ["required", "sourcePath", "sourceSha", "contentSha256", "verificationStatus"],
      "properties": {
        "required": { "const": true },
        "sourcePath": { "type": "null" },
        "sourceSha": { "type": "null" },
        "contentSha256": { "type": "null" },
        "verificationStatus": { "const": "unavailable" }
      }
    },
    "benchmarkSlot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["slotId", "category", "acquisitionStatus", "directUrl", "observedAt", "claimIds"],
      "properties": {
        "slotId": { "type": "string", "pattern": "^B(0[1-9]|1[0-2])$" },
        "category": { "enum": ["exam-preparation", "public-service-reference", "practical-visual-learning", "no-account-offline-education"] },
        "acquisitionStatus": { "const": "unacquired" },
        "directUrl": { "type": "null" },
        "observedAt": { "type": "null" },
        "claimIds": { "type": "array", "maxItems": 0 }
      }
    },
    "routeArchetype": {
      "type": "object",
      "additionalProperties": false,
      "required": ["archetypeId", "routeIds", "terminalDocuments"],
      "properties": {
        "archetypeId": { "enum": ["orientation", "study-launcher", "browse-reference", "focused-task", "review-results", "utility", "recovery"] },
        "routeIds": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "pattern": "^[a-z0-9-]+$" } },
        "terminalDocuments": { "type": "array", "uniqueItems": true, "items": { "enum": ["404", "410", "5xx"] } }
      }
    },
    "territory": {
      "type": "object",
      "additionalProperties": false,
      "required": ["territoryId", "internalHypothesis", "comparisonLabel", "differentiationAxes", "tokenValues", "evaluationStatus", "territoryStatus", "selectionEligible", "renderEnabled"],
      "properties": {
        "territoryId": { "enum": ["A", "B", "C"] },
        "internalHypothesis": { "enum": ["Editorial Field Guide", "Practical Workshop Manual", "Calm Study Companion"] },
        "comparisonLabel": { "enum": ["A", "B", "C"] },
        "differentiationAxes": { "type": "array", "minItems": 5, "uniqueItems": true, "items": { "type": "string" } },
        "renderEnabled": { "const": false },
        "selectionEligible": { "const": false },
        "territoryStatus": { "const": "provisional-shell" },
        "tokenValues": { "type": "null" },
        "evaluationStatus": { "const": "not-built-or-evaluated" }
      }
    },
    "evidenceInterface": {
      "type": "object",
      "additionalProperties": false,
      "required": ["interfaceId", "label", "recordFields", "records", "evidenceClass", "humanEvidence", "humanParticipantCountContribution", "notHumanUsabilityTested", "canIndependentlySelectTerritory"],
      "properties": {
        "interfaceId": { "enum": ["codex-heuristic-review", "automated-accessibility", "corpus-use", "route-simulation", "codex-experience-audit"] },
        "label": { "$ref": "#/$defs/artifactLabel" },
        "recordFields": { "type": "array", "minItems": 8, "uniqueItems": true, "items": { "type": "string" } },
        "records": { "type": "array", "maxItems": 0 },
        "evidenceClass": { "const": "nonhuman-supplementary-only" },
        "humanEvidence": { "const": "none" },
        "humanParticipantCountContribution": { "const": 0 },
        "notHumanUsabilityTested": { "const": true },
        "canIndependentlySelectTerritory": { "const": false }
      }
    },
    "routeSimulationTask": {
      "type": "object",
      "additionalProperties": false,
      "required": ["taskId", "archetypeId", "routeIds", "actorType", "humanParticipantCountContribution", "notHumanUsabilityTested"],
      "properties": {
        "taskId": { "type": "string", "pattern": "^[a-z0-9-]+$" },
        "archetypeId": { "enum": ["orientation", "study-launcher", "browse-reference", "focused-task", "utility", "recovery"] },
        "routeIds": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string" } },
        "actorType": { "const": "deterministic-harness" },
        "humanParticipantCountContribution": { "const": 0 },
        "notHumanUsabilityTested": { "const": true }
      }
    },
    "codexReviewRubric": {
      "type": "object",
      "additionalProperties": false,
      "required": ["agentTaskId", "criteria", "reviewStatus", "rubricId"],
      "properties": {
        "agentTaskId": { "type": "null" },
        "criteria": { "type": "array", "minItems": 5, "maxItems": 5, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
        "reviewStatus": { "const": "blocked-awaiting-exact-step-2-sha" },
        "rubricId": { "enum": ["consumer-trust-anti-ai-slop", "accessibility-cognitive-load", "visual-component-coherence"] }
      }
    }
  }
}
